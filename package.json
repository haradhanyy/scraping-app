{
  "name": "scraping-app",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "dev:worker": "bun run --filter worker dev",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "db:generate": "bun run --filter @scraping-app/db generate",
    "db:migrate": "bun run --filter @scraping-app/db migrate",
    "db:push": "bun run --filter @scraping-app/db push",
    "db:studio": "bun run --filter @scraping-app/db studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "reconcile:jobs": "bun run scripts/reconcile-jobs.ts",
    "reconcile:events": "bun run scripts/reconcile-events.ts",
    "test": "bunx playwright test",
    "test:ui": "bunx playwright test --ui",
    "test:headed": "bunx playwright test --headed",
    "test:api": "bunx playwright test tests/e2e/api-keys.spec.ts",
    "test:e2e": "bunx playwright test tests/e2e/ui.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@temporalio/client": "^1.11.6",
    "@types/node": "^26.6.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
