generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  instagram
  threads
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RATE_LIMITED
}

enum PostType {
  POST
  REEL
  THREAD
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum ScrapeEventType {
  SCRAPE_INSTAGRAM_POST
  SCRAPE_INSTAGRAM_REEL
  SCRAPE_INSTAGRAM_PROFILE
  SCRAPE_THREADS_POST
  SCRAPE_THREADS_THREAD
}

enum ScrapeEventStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RATE_LIMITED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apiKeys       ApiKey[]
  trackedTargets TrackedTarget[]
  webhooks      Webhook[]
  scrapeEvents  ScrapeEvent[]
}

model ApiKey {
  id          String   @id @default(cuid())
  keyHash     String   @unique
  prefix      String   // e.g., "apk_abc123"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?  // optional label for the key
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([prefix])
}

model Webhook {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  secret      String?  // for HMAC signature verification
  events      String[] // which events to fire for: ["scrape.completed", "scrape.failed", ...]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ProxyConfig {
  id          String   @id @default(cuid())
  host        String
  port        Int
  username    String?
  password    String?
  protocol    String   // "http" | "socks5"
  ipWhitelist String[] // IPs allowed to use this proxy
  country     String?  // for mobile/geo proxies
  isMobile    Boolean  @default(false)
  isActive    Boolean  @default(true)
  lastChecked DateTime?
  latencyMs   Int?
  successRate Float?   // 0-1
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([protocol, isActive])
}

model TrackedTarget {
  id              String   @id @default(cuid())
  platform        Platform
  handle          String   // @username without @
  displayName     String?
  avatarUrl       String?
  profileUrl      String
  isActive        Boolean  @default(true)
  scrapeFrequency String?  // e.g., "4 times daily"
  lastScrapedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  metrics         MetricSnapshot[]
  posts           Post[]
  comments        Comment[]
  jobs            ScrapeJob[]
  scrapeEvents    ScrapeEvent[]

  @@unique([platform, handle])
  @@index([isActive])
  @@index([platform, isActive])
  @@index([userId])
}

model MetricSnapshot {
  id            String   @id @default(cuid())
  targetId      String
  target        TrackedTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  followers     BigInt   @default(0)
  mentionVolume Int      @default(0)
  growthPct     Float?
  recordedAt    DateTime @default(now())

  @@index([targetId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
}

model Post {
  id            String   @id @default(cuid())
  targetId      String
  target        TrackedTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  platform      Platform
  postUrl       String   @unique
  type          PostType
  caption       String?  @db.Text
  likes         BigInt   @default(0)
  commentsCount Int      @default(0)
  views         BigInt?
  mediaUrls     String[]
  hashtags      String[]
  mentions      String[]
  postedAt      DateTime
  scrapedAt     DateTime @default(now())

  comments      Comment[]

  @@index([targetId, postedAt(sort: Desc)])
  @@index([platform, postedAt(sort: Desc)])
  @@index([type])
  @@index([hashtags])
  @@index([postUrl])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  targetId  String
  target    TrackedTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  author    String
  text      String   @db.Text
  sentiment Sentiment?
  keywords  String[]
  postedAt  DateTime
  scrapedAt DateTime @default(now())

  @@index([postId])
  @@index([targetId, postedAt(sort: Desc)])
  @@index([sentiment])
}

model ScrapeJob {
  id                 String    @id @default(cuid())
  targetId           String
  target             TrackedTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  platform           Platform
  targetUrl          String?
  status             JobStatus @default(QUEUED)
  attemptCount       Int       @default(0)
  maxPosts           Int       @default(10)
  maxComments        Int       @default(0)
  error              String?   @db.Text
  temporalWorkflowId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  posts              ScrapedPost[]

  @@index([targetId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([platform, status])
}

model ScrapedPost {
  id            String    @id @default(cuid())
  jobId         String
  job           ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  platform      Platform
  author        String
  authorAvatar  String?
  caption       String?   @db.Text
  likes         Int       @default(0)
  commentsCount Int       @default(0)
  views         Int?
  mediaUrls     String[]
  postUrl       String?
  postedAt      DateTime?
  scrapedAt     DateTime  @default(now())

  @@index([jobId])
  @@index([postUrl])
}

model ScrapeEvent {
  id          String           @id @default(cuid())
  eventId     String           @unique // "evt_<uuid>"
  type        ScrapeEventType
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId    String?
  target      TrackedTarget?   @relation(fields: [targetId], references: [id], onDelete: SetNull)
  payload     Json             // full scrape payload
  status      ScrapeEventStatus @default(PENDING)
  result      Json?            // scraped data
  error       String?
  webhookUrl  String?
  webhookSecret String?
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([userId, status])
  @@index([eventId])
  @@index([type, status])
}